# ==============================================================================
# CENTRAL DE OPERAÇÕES JB CUNHA — ARQUIVO DE CONFIGURAÇÃO DE PRODUÇÃO (.env)
# Copie este arquivo para .env no servidor/VPS: cp .env.example .env
# ==============================================================================

# Ambiente de execução (production / development)
NODE_ENV=production

# Porta de escuta da aplicação (Nginx faz proxy reverso para esta porta)
PORT=3000

# Chave secreta de alta entropia para assinatura dos tokens JWT/HMAC
# Recomenda-se gerar uma chave aleatória no Linux via: openssl rand -hex 48
AUTH_SECRET=sua_chave_secreta_super_segura_de_producao_jbcunha_2026

# Diretórios de persistência de dados e mídias
DATA_DIR=api-gateway/data
UPLOADS_DIR=web-app/uploads

# ------------------------------------------------------------------------------
# INTEGRAÇÃO OPCIONAL COM GLPI (Deixe false caso rode standalone)
# ------------------------------------------------------------------------------
GLPI_ENABLED=false
GLPI_URL=https://glpi.jbcunha.com.br/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
